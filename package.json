{
  "name": "reallm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test && vite build"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/howler": "^2.2.12",
    "@types/three": "^0.185.4",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
